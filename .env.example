# ═══════════════════════════════════════════════════════════════
# VOGUE AI — Environment Variables
# ═══════════════════════════════════════════════════════════════
# 1. Copy this file: rename it to .env.local
# 2. Paste your Gemini API key below
# 3. NEVER commit .env.local to GitHub
#
# Get your free key at: https://aistudio.google.com
# ═══════════════════════════════════════════════════════════════

GEMINI_API_KEY=paste_your_gemini_key_here

# ── API protection (see lib/guard.ts) ───────────────────────────
# Shared key the mobile app sends in X-Trenxia-Key. Generate a long random
# string (openssl rand -hex 24) and put the same value in the app's
# EXPO_PUBLIC_TRENXIA_KEY. When unset, the key check is skipped.
APP_CLIENT_KEY=

# Upstash Redis (free tier) — makes daily limits work across all Vercel
# instances. Create a database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides (defaults shown)
# GLOBAL_DAILY_LIMIT=5000
# LIMIT_ANALYZE_DEVICE=10
# LIMIT_ANALYZE_IP=30
# LIMIT_CHAT_DEVICE=60
# LIMIT_CHAT_IP=150
# LIMIT_EXPLORE_DEVICE=40
# LIMIT_EXPLORE_IP=100

# ── Uncomment when adding sign-in later ─────────────────────────
# NEXTAUTH_SECRET=generate_with: openssl rand -base64 32
# NEXTAUTH_URL=https://your-app.vercel.app
# GOOGLE_CLIENT_ID=from_google_cloud_console
# GOOGLE_CLIENT_SECRET=from_google_cloud_console
